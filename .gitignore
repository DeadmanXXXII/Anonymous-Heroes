# Build outputs — regenerated by the pipeline, don't commit
/output/

# Generated panel art — regenerated by generate_art.py, don't commit
/assets/generated/*
!/assets/generated/.gitkeep

# Generated per-issue YAML — regenerated by export_issue_yaml.py from
# content/source/issues_data.py, don't hand-edit or commit stale copies
/content/issues/*
!/content/issues/.gitkeep

__pycache__/
*.pyc
.venv/
venv/
.DS_Store
